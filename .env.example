# Copy to .env and fill in. .env holds secrets: never commit or share it.

# --- Bright Data zone (dashboard: Proxies -> your residential zone -> Access details)
BRIGHTDATA_CUSTOMER_ID=hl_xxxxxxxx
BRIGHTDATA_ZONE=residential_proxy1
BRIGHTDATA_PASSWORD=
# 33335 for new accounts; older accounts show 22225
BRIGHTDATA_PORT=33335
# Exit country, ISO alpha-2 lower case (blank = any)
BRIGHTDATA_COUNTRY=

# --- Provider keys (a tool with no key answers error=not_configured)
EXA_API_KEY=
BRAVE_API_KEY=
PARALLEL_API_KEY=

# --- Server
PORT=8080
# Bearer token Panja must send. Blank = open (only OK on a private network).
AUTH_TOKEN=

# Dev only: go out directly from this machine when no zone is set.
# REQUIRE_PROXY=false
